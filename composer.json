{
  "name": "jeremy/covoiturage-mvc",
  "description": "Application MVC PHP de covoiturage inter-sites",
  "type": "project",
  "require": {
    "php": "^8.1",
    "izniburak/router": "^3.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "test": "phpunit",
    "stan": "phpstan analyse src tests --level=7"
  }
}
